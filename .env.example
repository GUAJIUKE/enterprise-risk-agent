# ============================================================
# LLM 配置（复制为 backend/.env 后修改）
# ============================================================

# true = Mock 模式（无需任何 API Key，完整跑通 Demo）
# false = 真实 LLM 模式
MOCK_LLM=true

# OpenAI-compatible 接口（OpenAI / DeepSeek / 通义 / Moonshot / 本地 vLLM 均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2

# ============================================================
# RAG 配置
# ============================================================
# local = 本地轻量向量（离线可用）；openai = 调用 embedding 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# Agent 配置
# ============================================================
MAX_STEPS=8
TOOL_TIMEOUT=15
MAX_TOOL_REPEAT=2

# ============================================================
# 服务配置
# ============================================================
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_TO_FILE=true
